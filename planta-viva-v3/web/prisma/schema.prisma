generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id        String   @id @default(uuid())
  nombre    String
  versiones ProjectVersion[]
}

model ProjectVersion {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  padreId   String?
  grafoJson String
  autor     String
  fecha     DateTime @default(now())
  mensaje   String
}